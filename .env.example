# ── Base de datos ────────────────────────────────────────────────────────────
# PostgreSQL. En local: postgresql://postgres:postgres@127.0.0.1:5432/pdi
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/pdi?schema=public"

# ── Sesiones ─────────────────────────────────────────────────────────────────
# Secreto para firmar los JWT de sesión. Mínimo 32 caracteres.
# Generar con: openssl rand -base64 48
AUTH_SECRET="cambiar-este-secreto-por-uno-aleatorio-de-al-menos-32-caracteres"
# Duración de la sesión en horas
SESSION_HOURS="12"

# ── URL pública (usada por el renderizador de PDF) ───────────────────────────
APP_URL="http://localhost:3000"

# ── Motor de PDF ─────────────────────────────────────────────────────────────
# Ruta al ejecutable de Chromium/Chrome para el render server-side.
# Si se omite, se usa el Chromium que resuelva playwright-core.
# CHROMIUM_EXECUTABLE_PATH="/opt/pw-browsers/chromium-1194/chrome-linux/chrome"

# ── Semilla inicial (solo se usa en `npm run db:seed`) ───────────────────────
SEED_SUPERADMIN_EMAIL="admin@plataforma.com"
SEED_SUPERADMIN_PASSWORD="Admin2026!"
SEED_DEMO_PASSWORD="Demo2026!"
